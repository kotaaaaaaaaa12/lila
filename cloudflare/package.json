{
  "name": "lichess-cloudflare-overlay",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy --config ../wrangler.jsonc --containers-rollout=immediate",
    "check": "wrangler deploy --config ../wrangler.jsonc --dry-run --containers-rollout=none --outdir .dry-run",
    "test": "node --test test/*.test.mjs",
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "test:r2": "node test/persistence.workerd.mjs ./node_modules/miniflare/dist/src/index.js"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "wrangler": "4.151.0"
  }
}
